{
  "name": "practical-system-desktop",
  "version": "0.3.31",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run prepare:agent && node scripts/build.mjs",
    "bundle": "tauri build",
    "bundle:mac": "CI=true tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "bundle:mac:universal": "CI=true tauri build --target universal-apple-darwin --bundles app,dmg",
    "icons": "node scripts/build-app-icon.mjs",
    "tauri": "tauri",
    "prepare:agent": "node scripts/prepare-agent.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@lucide/vue": "^1.17.0",
    "@tauri-apps/api": "^2.11.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "0.28.2",
    "vite": "^7.1.2"
  }
}
